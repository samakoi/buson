// Schema do banco de dados do Bus On
// Documentação: veja Bus_On_Documentacao_Completa.docx, seção 8.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ALUNO
  MOTORISTA
  ADMIN
}

enum StatusCheckin {
  CONFIRMADO
  PROGRAMADO // aluno alocado no dia; ainda não confirmou a presença (a vaga já é dele)
  ESPERA
  CANCELADO
}

enum StatusFalta {
  REGISTRADA // registrada ao encerrar a viagem; pode ter justificativa aguardando decisão
  JUSTIFICADA
  INDEFERIDA
}

/// Motivo informado ao liberar a vaga antes da saída ("ausência avisada", não é falta)
enum MotivoAusencia {
  DOENCA
  COMPROMISSO_ACADEMICO
  COMPROMISSO_PESSOAL
  TRABALHO
  TRANSPORTE_PROPRIO
  OUTRO
  /// Liberada pelo sistema: o aluno faltou na ida do mesmo dia
  FALTOU_NA_IDA
}

enum SentidoViagem {
  IDA // leva os alunos às instituições
  VOLTA // busca os alunos nas instituições
}

enum StatusConta {
  PENDENTE // cadastrado, aguardando validação da matrícula
  ATIVO
  INATIVO // temporariamente sem usar o transporte
}

enum StatusDocumento {
  PENDENTE // enviado, aguardando o admin abrir
  EM_ANALISE
  APROVADO
  REPROVADO
}

enum TipoDocumento {
  DECLARACAO // declaração de matrícula
  COMPROVANTE // comprovante de matrícula
  OUTRO
}

enum MetodoEmbarque {
  QR_MOTORISTA // aluno escaneou o QR temporário exibido pelo motorista
  MANUAL // confirmado pelo motorista (recurso de emergência)
}

enum CategoriaNotificacao {
  GERAL
  CADASTRO
  DOCUMENTO
  LEMBRETE
  DIAS
  FALTA
  TRANSPORTE
  LIBERACAO
  ROTA
}

enum StatusViagem {
  AGUARDANDO
  EM_ANDAMENTO
  ENCERRADA
}

model Usuario {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senhaHash    String
  papel        Papel
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  aluno                Aluno?
  motorista            Motorista?
  notificacoes         Notificacao[]
  auditorias           Auditoria[]
  documentosAnalisados Documento[]    @relation("DocumentoAnalisadoPor")
  faltasDecididas      Falta[]        @relation("FaltaDecididaPor")
  refreshTokens        RefreshToken[]

  @@map("usuarios")
}

model Universidade {
  id       String   @id @default(uuid())
  nome     String   @unique
  endereco String?
  criadoEm DateTime @default(now())

  alunos     Aluno[]
  pontosRota PontoRota[]

  @@map("universidades")
}

model Aluno {
  id             String       @id @default(uuid())
  usuarioId      String       @unique
  usuario        Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  universidadeId String
  universidade   Universidade @relation(fields: [universidadeId], references: [id])
  qrCode         String       @unique @default(uuid())
  matricula      String?      @unique
  curso          String?
  telefone       String?
  fotoArquivo    String?
  statusConta    StatusConta  @default(PENDENTE)
  criadoEm       DateTime     @default(now())

  checkins   Checkin[]
  documentos Documento[]
  embarques  Embarque[]
  alocacoes  AlocacaoAluno[]
  faltas     Falta[]

  @@map("alunos")
}

model Onibus {
  id                   String   @id @default(uuid())
  placa                String   @unique
  capacidade           Int      @default(30)
  emManutencao         Boolean  @default(false)
  observacaoManutencao String? // ex.: "Troca de pneus, volta na sexta"
  criadoEm             DateTime @default(now())

  motoristas      Motorista[]
  viagens         Viagem[]
  sessoesEmbarque BoardingSession[]
  programacoes    Programacao[]

  @@map("onibus")
}

model Motorista {
  id        String   @id @default(uuid())
  usuarioId String   @unique
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  onibusId  String?
  onibus    Onibus?  @relation(fields: [onibusId], references: [id])
  criadoEm  DateTime @default(now())

  viagens         Viagem[]
  sessoesEmbarque BoardingSession[]
  programacoes    Programacao[]

  @@map("motoristas")
}

model Rota {
  id       String   @id @default(uuid())
  nome     String
  criadoEm DateTime @default(now())

  pontos         PontoRota[]
  viagens        Viagem[]
  pontosEmbarque RotaPontoEmbarque[]
  programacoes   Programacao[]
  alocacoes      AlocacaoAluno[]

  @@map("rotas")
}

model PontoRota {
  id             String       @id @default(uuid())
  rotaId         String
  rota           Rota         @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  universidadeId String
  universidade   Universidade @relation(fields: [universidadeId], references: [id])
  ordem          Int

  @@map("pontos_rota")
}

/// Local onde os alunos esperam o ônibus na ida (praça, bairro, parada)
model PontoEmbarque {
  id           String   @id @default(uuid())
  nome         String   @unique
  endereco     String?
  latitude     Float?
  longitude    Float?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  rotas     RotaPontoEmbarque[]
  alocacoes AlocacaoAluno[]
  checkins  Checkin[]

  @@map("pontos_embarque")
}

/// Pontos de embarque de uma rota, na ordem em que o ônibus passa
model RotaPontoEmbarque {
  id              String        @id @default(uuid())
  rotaId          String
  rota            Rota          @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  pontoEmbarqueId String
  pontoEmbarque   PontoEmbarque @relation(fields: [pontoEmbarqueId], references: [id])
  ordem           Int

  @@unique([rotaId, pontoEmbarqueId])
  @@map("rota_pontos_embarque")
}

/// Programação semanal de uma rota: gera as viagens de ida/volta dos próximos dias.
/// A capacidade de cada dia é a capacidade do ônibus. Uma programação ativa por rota.
model Programacao {
  id              String    @id @default(uuid())
  rotaId          String
  rota            Rota      @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  onibusId        String
  onibus          Onibus    @relation(fields: [onibusId], references: [id])
  motoristaId     String
  motorista       Motorista @relation(fields: [motoristaId], references: [id])
  horarioIda      String // HH:MM
  horarioVolta    String? // HH:MM (null = sem volta)
  /// Dias da semana em que a rota opera: 0 = domingo … 6 = sábado
  diasSemana      Json
  /// Viagens canceladas pelo admin (ex.: feriado), que a geração não recria: ["IDA:2026-10-12", ...]
  datasCanceladas Json?
  ativa           Boolean   @default(true)
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  viagens Viagem[]

  @@index([rotaId, ativa])
  @@map("programacoes")
}

/// Dia fixo de uso do transporte pelo aluno (um por dia da semana)
model AlocacaoAluno {
  id              String         @id @default(uuid())
  alunoId         String
  aluno           Aluno          @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  diaSemana       Int // 0 = domingo … 6 = sábado
  rotaId          String
  rota            Rota           @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  pontoEmbarqueId String?
  pontoEmbarque   PontoEmbarque? @relation(fields: [pontoEmbarqueId], references: [id], onDelete: SetNull)
  ativo           Boolean        @default(true)
  criadoEm        DateTime       @default(now())
  atualizadoEm    DateTime       @updatedAt

  @@unique([alunoId, diaSemana])
  @@index([rotaId, diaSemana, ativo])
  @@map("alocacoes_aluno")
}

model Viagem {
  id            String        @id @default(uuid())
  rotaId        String
  rota          Rota          @relation(fields: [rotaId], references: [id])
  onibusId      String
  onibus        Onibus        @relation(fields: [onibusId], references: [id])
  motoristaId   String
  motorista     Motorista     @relation(fields: [motoristaId], references: [id])
  data          DateTime
  horario       String
  vagas         Int           @default(30)
  status        StatusViagem  @default(AGUARDANDO)
  sentido       SentidoViagem @default(IDA)
  /// Viagem gerada pela programação semanal (null = criada avulsa pelo admin)
  programacaoId String?
  programacao   Programacao?  @relation(fields: [programacaoId], references: [id], onDelete: SetNull)
  latitude      Float?
  longitude     Float?
  criadoEm      DateTime      @default(now())

  checkins        Checkin[]
  sessoesEmbarque BoardingSession[]
  embarques       Embarque[]
  faltas          Falta[]

  @@unique([programacaoId, sentido, data])
  @@map("viagens")
}

model Checkin {
  id              String          @id @default(uuid())
  viagemId        String
  viagem          Viagem          @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  alunoId         String
  aluno           Aluno           @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  status          StatusCheckin   @default(CONFIRMADO)
  embarcado       Boolean         @default(false)
  /// Onde o aluno embarca (vem da alocação do dia)
  pontoEmbarqueId String?
  pontoEmbarque   PontoEmbarque?  @relation(fields: [pontoEmbarqueId], references: [id], onDelete: SetNull)
  /// Vaga liberada antes da saída: o motivo informado (ausência avisada — não é falta)
  motivoAusencia  MotivoAusencia?
  canceladoEm     DateTime?
  posicaoFila     Int?
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt

  @@unique([viagemId, alunoId])
  @@map("checkins")
}

model Notificacao {
  id        String               @id @default(uuid())
  usuarioId String
  usuario   Usuario              @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  categoria CategoriaNotificacao @default(GERAL)
  mensagem  String               @db.VarChar(500)
  lida      Boolean              @default(false)
  criadoEm  DateTime             @default(now())

  @@index([usuarioId, lida])
  @@map("notificacoes")
}

/// Falta: aluno com vaga que não embarcou numa viagem encerrada (uma por aluno por viagem)
model Falta {
  id                 String      @id @default(uuid())
  alunoId            String
  aluno              Aluno       @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  viagemId           String
  viagem             Viagem      @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  status             StatusFalta @default(REGISTRADA)
  /// Até quando o próprio aluno pode justificar (depois, só a administração)
  prazoJustificativa DateTime
  justificativa      String?     @db.VarChar(500)
  justificadaEm      DateTime?
  /// Anexo opcional (atestado etc.): chave no armazenamento + metadados
  anexoArquivo       String?
  anexoNome          String?
  anexoMimeType      String?
  anexoTamanho       Int?
  decididoPorId      String?
  decididoPor        Usuario?    @relation("FaltaDecididaPor", fields: [decididoPorId], references: [id], onDelete: SetNull)
  decididoEm         DateTime?
  /// Motivo do indeferimento ou observação ao justificar
  observacaoDecisao  String?     @db.VarChar(300)
  criadoEm           DateTime    @default(now())

  @@unique([viagemId, alunoId])
  @@index([alunoId, criadoEm])
  @@index([status])
  @@map("faltas")
}

/// Comprovante de matrícula enviado pelo aluno (Fase 2)
model Documento {
  id               String          @id @default(uuid())
  alunoId          String
  aluno            Aluno           @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  tipo             TipoDocumento
  arquivo          String // caminho relativo dentro da pasta de uploads
  nomeOriginal     String
  mimeType         String
  tamanho          Int
  status           StatusDocumento @default(PENDENTE)
  motivoReprovacao String?         @db.VarChar(300)
  analisadoPorId   String?
  analisadoPor     Usuario?        @relation("DocumentoAnalisadoPor", fields: [analisadoPorId], references: [id], onDelete: SetNull)
  analisadoEm      DateTime?
  criadoEm         DateTime        @default(now())

  @@index([alunoId, criadoEm])
  @@index([status])
  @@map("documentos")
}

/// Sessão de embarque: o QR temporário que o motorista exibe durante a viagem.
/// O QR carrega um token aleatório; o banco guarda só o hash.
model BoardingSession {
  id          String    @id @default(uuid())
  viagemId    String
  viagem      Viagem    @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  motoristaId String
  motorista   Motorista @relation(fields: [motoristaId], references: [id])
  onibusId    String
  onibus      Onibus    @relation(fields: [onibusId], references: [id])
  tokenHash   String    @unique @db.Char(64)
  expiraEm    DateTime
  ativa       Boolean   @default(true)
  criadoEm    DateTime  @default(now())

  embarques Embarque[]

  @@index([viagemId, ativa])
  @@map("boarding_sessions")
}

/// Histórico de embarques (um por aluno por viagem)
model Embarque {
  id              String           @id @default(uuid())
  viagemId        String
  viagem          Viagem           @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  alunoId         String
  aluno           Aluno            @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  metodo          MetodoEmbarque
  sessaoId        String?
  sessao          BoardingSession? @relation(fields: [sessaoId], references: [id], onDelete: SetNull)
  /// Quem registrou no embarque manual (motorista)
  registradoPorId String?
  dataHora        DateTime         @default(now())
  /// Localização opcional (será usada na fase de GPS)
  latitude        Float?
  longitude       Float?
  criadoEm        DateTime         @default(now())

  @@unique([viagemId, alunoId])
  @@map("embarques")
}

/// Registro de ações importantes (Regra 10 — auditoria)
model Auditoria {
  id            String   @id @default(uuid())
  usuarioId     String? // quem fez (null = sistema)
  usuario       Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  acao          String
  entidade      String
  entidadeId    String
  detalhes      Json?
  valorAnterior Json?
  valorNovo     Json?
  criadoEm      DateTime @default(now())

  @@index([entidade, entidadeId])
  @@map("auditorias")
}

/// Sessão de um dispositivo (refresh token com rotação e revogação).
/// Só o hash SHA-256 do token é guardado.
model RefreshToken {
  id               String    @id @default(uuid())
  usuarioId        String
  usuario          Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash        String    @unique @db.Char(64)
  deviceId         String?   @db.VarChar(100)
  ip               String?   @db.VarChar(64)
  userAgent        String?   @db.VarChar(255)
  expiraEm         DateTime
  revogadoEm       DateTime?
  /// Preenchido na rotação: aponta para o token que substituiu este
  substituidoPorId String?
  ultimoUsoEm      DateTime  @default(now())
  criadoEm         DateTime  @default(now())

  @@index([usuarioId, revogadoEm])
  @@map("refresh_tokens")
}
