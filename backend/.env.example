# Copie para ".env" e ajuste para o seu ambiente. O .env NUNCA vai para o git.
# Ambientes: development | staging | production (test = testes automatizados)
NODE_ENV=development

# Porta da API (rotas em /api/v1)
PORT=3333

# MySQL: usuario:senha@host:porta/banco
# Use um banco diferente para cada ambiente — nunca teste no banco de produção.
DATABASE_URL="mysql://root:senha123@localhost:3306/bus_on"

# Segredo do access token. Em produção: 32+ caracteres aleatórios
# (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET="troque-este-valor-por-uma-string-aleatoria-grande"
JWT_EXPIRES_IN="15m"

# Validade da sessão de cada dispositivo (refresh token), em dias
REFRESH_TOKEN_DIAS=30

# Origens web permitidas (CORS), separadas por vírgula. Apps nativos não precisam disso.
# Desenvolvimento com Expo web: http://localhost:8081
# Produção: só os domínios reais (ex.: https://app.seudominio.com.br). Nunca "*" em produção.
CORS_ORIGINS="http://localhost:8081"

# Quantos proxies confiar para descobrir o IP real (Cloudflare Tunnel: 1; direto: 0)
TRUST_PROXY=0

# Nível dos logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Limites de tentativas (por janela: login e refresh 15 min, cadastro 1 h)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_CADASTRO_MAX=5
RATE_LIMIT_REFRESH_MAX=60

# Pasta dos arquivos enviados (documentos). Fora da pasta pública; em produção
# prefira armazenamento em nuvem (S3, R2, Azure Blob, GCS).
# UPLOADS_DIR=./uploads

# Validade do QR de embarque exibido pelo motorista, em minutos (renovado automaticamente;
# "Atualizar QR" no app do motorista invalida o anterior na hora)
BOARDING_QR_MINUTOS=60
