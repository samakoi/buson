# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente

# String de conexão do MySQL: usuario:senha@host:porta/banco
DATABASE_URL="mysql://root:senha123@localhost:3306/bus_on"

# Porta em que a API vai rodar
PORT=3333

# Segredos para os tokens JWT (troque por valores aleatórios em produção)
JWT_SECRET="troque-este-valor-por-uma-string-aleatoria-grande"
JWT_REFRESH_SECRET="troque-este-valor-tambem-por-outra-string-aleatoria"

# Tempo de expiração dos tokens
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
