{
  "expo": {
    "name": "Bus On",
    "slug": "bus-on",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buson.app"
    },
    "android": {
      "package": "com.buson.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E5AA8"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D2F52",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0B1520",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Bus On usa a câmera para ler o QR Code de embarque e para fotografar seu comprovante de matrícula.",
          "recordAudioAndroid": false
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Bus On acessa suas fotos para você anexar o comprovante de matrícula.",
          "cameraPermission": "O Bus On usa a câmera para ler o QR Code de embarque e para fotografar seu comprovante de matrícula.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icone-notificacao.png",
          "color": "#1E5AA8",
          "defaultChannel": "avisos"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O Bus On usa a localização do celular do motorista durante a viagem para os alunos acompanharem o ônibus.",
          "locationWhenInUsePermission": "O Bus On usa a localização para mostrar o ônibus no mapa e registrar as coordenadas dos pontos.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "androidForegroundServiceIcon": "./assets/icone-notificacao.png"
        }
      ]
    ]
  }
}
