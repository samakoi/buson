# Modelo do arquivo de ambiente do Docker (produção e staging). NUNCA vai para o git.
# Não copie à mão: rode   .\deploy\gerar-segredos.ps1 -Ambiente producao   (ou staging)
# Ele cria deploy/.env.producao com senhas aleatórias; depois complete o que falta aqui.

# production | staging (staging tem as mesmas exigências de segurança da produção)
NODE_ENV=production

# Porta na própria máquina (só 127.0.0.1): produção 4000, staging 4001
PORTA_LOCAL=4000

# --- Segredos (gerados pelo gerar-segredos.ps1) ---
JWT_SECRET=__GERAR__
MYSQL_SENHA=__GERAR__
MYSQL_SENHA_ROOT=__GERAR__

# --- Acesso pela internet ---
# Token do Cloudflare Tunnel deste ambiente (Zero Trust → Networks → Tunnels → o túnel → token).
# Vazio = sem túnel (a API fica só em 127.0.0.1:PORTA_LOCAL)
TUNNEL_TOKEN=
# Atrás do Cloudflare Tunnel: 1 (para o limite de tentativas enxergar o IP real)
TRUST_PROXY=1
# O app Android não precisa de CORS. Deixe vazio, a não ser que exista um site web do Bus On.
CORS_ORIGINS=

# --- Backup ---
# Pasta no Windows onde ficam os backups (relativa a esta pasta deploy/ ou absoluta, ex.: D:/buson-backups/producao)
PASTA_BACKUPS=../backups/producao
BACKUP_HORARIO=03:00
BACKUP_DIAS_LOCAL=14
BACKUP_DIAS_NUVEM=30
# Cloudflare R2 (cópia fora da máquina). Vazio = só backup local.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Monitoramento ---
# DSN do projeto da API no Sentry (vazio = desligado)
SENTRY_DSN=
LOG_LEVEL=info

# --- Push e lembretes ---
PUSH_MODO=expo
EXPO_ACCESS_TOKEN=
LEMBRETE_SAIDA_MINUTOS=60
LEMBRETE_VESPERA_HORARIO=20:00

# --- Regras (os padrões servem para a maioria dos casos) ---
TZ=America/Fortaleza
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DIAS=30
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_CADASTRO_MAX=5
RATE_LIMIT_REFRESH_MAX=60
BOARDING_QR_MINUTOS=60
DIAS_GERACAO_VIAGENS=7
GPS_RETENCAO_DIAS=90
