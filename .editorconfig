# Padrão de editor do Bus On (VS Code, JetBrains etc. leem este arquivo)
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Duas espaços no fim da linha = quebra de linha no Markdown
trim_trailing_whitespace = false

[*.ps1]
# Scripts do PowerShell do Windows: CRLF e 4 espaços
end_of_line = crlf
indent_size = 4
